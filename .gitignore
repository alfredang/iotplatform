# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# prisma generated migration lock is committed; local sqlite/db dumps are not
*.db

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright mcp artifacts
.playwright-mcp

# local MCP server config (may contain machine-specific paths/secrets)
/.mcp.json
/.cursor/mcp.json

# lockfile not tracked in this repo
/package-lock.json

# installed third-party Claude skills — vendored content is reproducible from
# skills-lock.json (npx skills add), so we don't commit the 2MB+ of packages.
/.agents/
/.claude/skills/*
!/.claude/skills/.gitkeep

# Distribution archives (rebuildable — never pushed to GitHub)
*.zip

# Source material the project was derived from — not ours to republish.
**/reference/
